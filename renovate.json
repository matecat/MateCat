{
  "labels": ["dependencies"],
  "extends": [":semanticCommitTypeAll(🔧 chore)"],
  "commitMessageAction": "update",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": false,
      "minimumReleaseAge": "20 days"
    },
    {
      "description": "@babel/eslint-parser 8 needs ESLint 9; hold it on 7 until ESLint is upgraded",
      "matchPackageNames": ["@babel/eslint-parser"],
      "allowedVersions": "<8"
    }
  ],
  "branchConcurrentLimit": 3,
  "timezone": "Europe/Rome",
  "schedule": [
    "after 10pm on thursday and friday",
    "before 5am on thursday and friday"
  ],
  "baseBranchPatterns": ["develop"],
  "git-submodules": {
    "enabled": true
  }
}
